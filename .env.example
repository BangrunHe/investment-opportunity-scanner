# ============================================================
# 环境变量模板 —— 复制为 .env 并填入真实值
# 格式：KEY=VALUE（值无需加引号，# 开头为注释）
#
# 注意：云端正常运行**不需要** .env —— 那些值配在 Supabase Secrets。
#      本文件仅供本地 Python 工具（src/、tools/）使用。
# ============================================================

# ---- 本地 Supabase 访问（tools/ 里的运维脚本需要）----
SUPABASE_URL=
SUPABASE_KEY=
# Supabase 在境外，通常需要代理；留空则自动探测本机 7897/7890/10809/1080
SUPABASE_PROXY=

# ---- 大模型 ----
DEEPSEEK_API_KEY=
VISION_API_KEY=
VISION_MODEL=qwen3.8-flash
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 飞书 ----
# tools/feishu_chat_id.py 与 tools/feishu_bitable_records.py 需要
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_CHAT_ID=

# ---- 以下为可选/遗留项 ----
# 自定义机器人 webhook（若不用应用机器人发消息才需要）
FEISHU_BOT_WEBHOOK=
FEISHU_BOT_SECRET=
# 邮件提醒（本地路径可选，云端已改用飞书）
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=
